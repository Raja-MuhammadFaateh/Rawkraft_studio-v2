# ==============================================================================
# RAWKRAFT STUDIO: ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# All other variables are strictly server-only secrets. Never commit .env.local!
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://rawkraftstudio.com

# Admin Session Cryptographic Secret (Server-only, min 32 characters)
# Used to HMAC-sign session cookies. If unset, derives from SUPABASE_SERVICE_ROLE_KEY.
ADMIN_SESSION_SECRET=change-this-to-a-very-secure-random-32-byte-hex-secret-in-production

# Supabase PostgreSQL, Auth & Storage
# NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Client public key (restricted by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Server-only superadmin key (bypasses RLS). NEVER EXPOSE!
SUPABASE_SERVICE_ROLE_KEY=
# Set to 'true' in production to enforce strict database connectivity (fail-closed)
REQUIRE_SUPABASE=false

# Studio AI Integration (Server-side Only)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VECTOR_STORE_ID=

# Upstash Redis for Persistent Distributed Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=